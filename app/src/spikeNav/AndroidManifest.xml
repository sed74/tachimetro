<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- D-01 spike NAVIGATION: NavigationTemplate richiede NAVIGATION_TEMPLATES e categoria
         NAVIGATION; ACCESS_SURFACE serve a AppManager.setSurfaceCallback(). Temporaneo (D-02).
         Rischio NF-1/NF-6 in revisione: mai distribuito (D-05). -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <application>
        <!-- D-01: tools:node="replace" ridichiara l'intero service. Il merger unisce gli
             intent-filter per contenuto, quindi un tools:node="remove" sulla sola category
             non basta in modo affidabile a togliere la categoria POI ereditata da main. -->
        <service
            android:name=".car.TachimetroCarAppService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            tools:node="replace">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
    </application>

</manifest>
